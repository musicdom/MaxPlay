# Server
NODE_ENV=production
PORT=8080

# Yandex Managed Redis connection string.
# Use rediss:// when TLS is enabled. Never commit real credentials.
REDIS_URL=rediss://username:password@redis-host:6380

# MAX bot token — store only in Yandex Lockbox / environment variables.
MAX_BOT_TOKEN=
# Must be 5-256 chars: A-Z, a-z, 0-9, underscore or hyphen.
MAX_WEBHOOK_SECRET=
MAX_MINI_APP_URL=https://your-mini-app-domain.example
MAX_WEBHOOK_URL=https://your-yandex-function-url/api/max/webhook

# Public URLs of the legal documents (GitHub Pages).
LEGAL_BASE_URL=https://musicdom.github.io/MaxPlay/legal
USER_AGREEMENT_VERSION=1.0.0
PRIVACY_POLICY_VERSION=1.0.0
MAX_AUTH_MAX_AGE_SECONDS=86400

# Set to the exact GitHub Pages origin after deployment, e.g. https://musicdom.github.io
ALLOWED_ORIGIN=https://musicdom.github.io
