# Local development only. Never put real production secrets in GitHub.
# Yandex Managed Redis; use rediss:// when TLS is enabled.
REDIS_URL=

# Optional Upstash REST fallback; used only when REDIS_URL is empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=
MAX_MINI_APP_URL=

# Use the exact GitHub Pages origin.
ALLOWED_ORIGIN=https://musicdom.github.io
LEGAL_BASE_URL=https://musicdom.github.io/MaxPlay/legal
USER_AGREEMENT_VERSION=1.0.0
PRIVACY_POLICY_VERSION=1.0.0
MAX_AUTH_MAX_AGE_SECONDS=86400

# Comma-separated MAX user IDs.
ADMIN_MAX_IDS=

# YooMoney settings. Keep empty until payment notifications are configured.
YOOMONEY_RECEIVER=
YOOMONEY_NOTIFICATION_SECRET=
YOOMONEY_SUCCESS_URL=https://musicdom.github.io/MaxPlay/?payment=success
